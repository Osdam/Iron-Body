<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- El ejecutable se llama IronBody.ReceiptPrinter.exe: es el nombre que ve el técnico en el
         Administrador de tareas y en el servicio. El espacio de nombres sigue el del proyecto. -->
    <AssemblyName>IronBody.ReceiptPrinter</AssemblyName>
    <RootNamespace>IronBody.ReceiptAgent</RootNamespace>
    <!-- No es una app de IIS: sin web.config en la publicación. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Sin recorte: la serialización JSON y la configuración usan reflexión. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Release (lo que va al paquete): sin PDB. El PDB embebido llevaba rutas locales del
       desarrollador y el repositorio/commit de SourceLink. ContinuousIntegrationBuild normaliza además
       cualquier ruta de origen que el compilador incruste. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- La configuración de desarrollo (backend de archivo, API local) nunca viaja al paquete. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IronBody.ReceiptAgent.Tests" />
  </ItemGroup>

</Project>
